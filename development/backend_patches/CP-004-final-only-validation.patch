+def _review_response(*, final: bool = False, failed: bool = False) -> str:
+    """Inspect a no-op fixture without claiming any intermediate test evidence."""
+    return json.dumps(dict(verdict="stop" if failed else "accept", new_findings=[], resolved_finding_ids=[],
+        criteria_satisfied_without_change=not failed, reason="Final validation failed." if failed else "", notes="Inspected exact fixture source.",
+        criterion_evidence=[] if final else [dict(criterion_index=0, basis="reviewer_judgment",
+            validation_ids=[], explanation="Inspection confirms the unchanged fixture source.")]))
+
+
+def _prepare_final(preflight, *, store, run_id):
+    """Reach final validation through real setup and inspection-only role handoffs."""
+    if store.run_directory(run_id).exists():
+        return store.load_state(run_id)
+    state = initialize_run(preflight, role_selections=ROLE_SELECTIONS, store=store, run_id=run_id)
+    assert state.phase is RunPhase.DESIGN and state.validation_results == ()
+    steps = (
+        _Step(json.dumps(dict(status="ready", milestones=[dict(id="m1", objective="Inspect fixture source",
+            acceptance_criteria=["The fixture source remains exact and available."])], reason=""))),
+        _Step(json.dumps(dict(status="prescribe", instructions="Inspect fixture source without changing it.",
+                             addresses=[], proposal="", reason=""))),
+        _Step(json.dumps(dict(status="completed", summary="Inspected the unchanged fixture source.", reason=""))),
+        _Step(_review_response()),
+    )
+    adapter = _RecordingAdapter(steps)
+    adapter.bind_runtime(state, store)
+    state = run_milestone_workflow(preflight, run_id=run_id, store=store, adapter=adapter)
+    assert state.phase is RunPhase.FINAL_VALIDATE and state.validation_results == (), state.stop_reason
+    return state
+
+
+def _finish_profile(preflight, *, store, run_id):
+    """Use final acceptance/recovery gates without allowing any new implementation."""
+    state = store.load_state(run_id)
+    results = tuple(store.load_validation_result(run_id, ref) for ref in state.validation_results)
+    failed = any(result.outcome is not ValidationOutcome.PASSED for result in results)
+    adapter = _RecordingAdapter((_Step(_review_response(final=True, failed=failed)),))
+    adapter.bind_runtime(state, store)
+    return run_final_workflow(preflight, run_id=run_id, store=store, adapter=adapter)
+
+
+def _run_profile(preflight, *, role_selections, store, run_id, validation_fault_injector=None):
+    """Run only the final frozen profile, preserving all command fault boundaries."""
+    state = _prepare_final(preflight, store=store, run_id=run_id)
+    with store.acquire_repository(preflight):
+        state = run_final_validation(preflight, state=state, store=store,
+                                     fault_injector=validation_fault_injector)
+    if state.phase is RunPhase.STOPPED_INCOMPLETE:
+        return state
+    return _finish_profile(preflight, store=store, run_id=run_id)
+
+
+def _resume_profile(preflight, *, store, run_id):
+    """Resume through the final controller's quarantine/reset/no-replay gates."""
+    state = store.load_state(run_id)
+    results = tuple(store.load_validation_result(run_id, ref) for ref in state.validation_results)
+    failed = any(result.outcome is not ValidationOutcome.PASSED for result in results)
+    adapter = _RecordingAdapter((_Step(_review_response(final=True, failed=failed)),))
+    return resume(run_id, store=store, adapter_factory=lambda state, store: adapter.bind_runtime(state, store))
+
+
+def _validation_refs(state):
+    """Terminal acceptance keeps exact results in its immutable final receipt."""
+    if state.final_receipt is not None:
+        return StateStore().load_final_receipt(state.identity.run_id, state.final_receipt.artifact).validation_artifacts
+    return state.validation_results
+
