+"""Prove the controller alone executes one profile after all milestone work."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import sys
+import unittest
+from unittest.mock import patch
+
+from cwi.evidence import ReviewMode
+from cwi.orchestration import StartOptions, resume, start
+from cwi.state import AgentRole, RunPhase
+from cwi.state_store import StateStore
+from tests.role_selection_fixtures import ROLE_SELECTIONS
+from tests.test_repair import COMPLETED, prescription, write
+from tests.test_workflow import InjectedCrash, _RecordingAdapter, _Step, _WorkflowFixture
+
+
+def assessment(verdict="accept", *, final=False):
+    """Build an inspection verdict without inventing intermediate test evidence."""
+    return json.dumps(dict(
+        verdict=verdict,
+        new_findings=([dict(summary="Greeting needs correction", expected="Correct greeting",
+            observed="Incorrect greeting", evidence="Inspected greeting.txt", validation_ids=[])]
+            if verdict == "repair" else []),
+        resolved_finding_ids=[], criteria_satisfied_without_change=final and verdict == "accept",
+        reason="Final checks failed" if verdict == "stop" else "", notes="Source inspected.",
+        criterion_evidence=[] if final or verdict != "accept" else [dict(
+            criterion_index=0, basis="reviewer_judgment", validation_ids=[],
+            explanation="Inspected the required greeting and its test assertions.")]))
+
+
+class FinalOnlyValidationTests(_WorkflowFixture, unittest.TestCase):
+    """Exercise public start/resume with real commands and scripted read-only roles."""
+
+    def _configure(self, *, fail=False):
+        """Count actual executions outside source while preserving a frozen command."""
+        self.executions = self.root / "executions.txt"
+        program = ("from pathlib import Path; "
+            f"p=Path({str(self.executions)!r}); "
+            "p.write_text((p.read_text() if p.exists() else '')+'executed\\n'); "
+            + ("raise SystemExit(1)" if fail else
+               "assert Path('greeting.txt').read_text() == 'hello milestone two!\\n'"))
+        self.config.write_text("schema_version=1\nmax_milestones=2\n[[validation]]\n"
+            'id="tests"\n' + f"argv={json.dumps([sys.executable, '-B', '-c', program])}\n"
+            'cwd="."\ntimeout_seconds=10\n')
+
+    def _steps(self, verdict="accept"):
+        """Describe two independent milestone inspections followed by one final review."""
+        design = json.dumps(dict(status="ready", reason="", milestones=[dict(
+            id=f"m{i}", objective=f"Greeting stage {i}", acceptance_criteria=["Greeting is correct"])
+            for i in (1, 2)]))
+        return (_Step(design), _Step(prescription()),
+            _Step(COMPLETED, effect=write("hello milestone one\n")), _Step(assessment()),
+            _Step(prescription()), _Step(COMPLETED, effect=write("hello milestone two!\n")),
+            _Step(assessment()), _Step(assessment(verdict, final=True)))
+
+    def _start(self, steps=None):
+        """Start through the real orchestration path and retain all delivered contexts."""
+        adapter = _RecordingAdapter(steps or self._steps())
+        state = start(StartOptions(role_selections=ROLE_SELECTIONS, request_path=self.request,
+            config_text=self.config.read_text(), working_directory=self.repository),
+            adapter_factory=lambda state, store: adapter.bind_runtime(state, store))
+        return state, adapter
+
+    def test_two_milestones_execute_one_final_profile(self):
+        """No base/intermediate command runs; only final review receives actual results."""
+        self._configure()
+        state, adapter = self._start()
+        self.assertEqual(state.phase, RunPhase.ACCEPTED_UNMERGED, state.stop_reason)
+        self.assertEqual(self.executions.read_text().splitlines(), ["executed"])
+        for call in adapter.calls[:-1]:
+            self.assertNotIn('"validation_evidence"', call["prompt"])
+        self.assertIn('"validation_evidence"', adapter.calls[-1]["prompt"])
+        store = StateStore()
+        for ref in state.milestone_receipts:
+            receipt = store.load_milestone_receipt(state.identity.run_id, ref.artifact)
+            self.assertEqual(receipt.validation_artifacts, ())
+            self.assertEqual(receipt.review_binding.ordered_validation_result_digests, ())
+        receipt = store.load_final_receipt(state.identity.run_id, state.final_receipt.artifact)
+        self.assertEqual(len(receipt.validation_artifacts), 1)
+        self.assertEqual(receipt.review_binding.review_mode, ReviewMode.FINAL)
+
+    def test_final_failure_reaches_final_reviewer_once_and_cannot_accept(self):
+        """Failed final checks remain visible, cannot be accepted, and never trigger reruns."""
+        self._configure(fail=True)
+        state, adapter = self._start(self._steps("stop"))
+        self.assertEqual(state.phase, RunPhase.STOPPED_INCOMPLETE)
+        self.assertEqual(self.executions.read_text().splitlines(), ["executed"])
+        self.assertIn('"outcome":"failed"', adapter.calls[-1]["prompt"])
+        self.assertIsNone(state.final_receipt)
+        self.assertFalse(state.resume_allowed)
+        self.assertEqual(resume(state.identity.run_id), state)
+
+    def test_final_repair_stops_without_another_writer_or_test_run(self):
+        """Once-only validation cannot be followed by changed source and stale acceptance."""
+        self._configure()
+        steps = self._steps("repair")
+        state, adapter = self._start(steps)
+        self.assertEqual(state.phase, RunPhase.STOPPED_INCOMPLETE)
+        self.assertEqual(len(adapter.calls), len(steps))
+        self.assertEqual(self.executions.read_text().splitlines(), ["executed"])
+        self.assertIn("final", state.stop_reason.lower())
+        self.assertFalse(state.resume_allowed)
+        self.assertEqual(len(state.milestone_receipts), 2)
+        self.assertIsNone(state.final_receipt)
+
+    def test_final_review_state_cannot_reenter_implementation(self):
+        """The durable state model forbids final scope from becoming a Writer task."""
+        from dataclasses import replace
+        from cwi.state import StateRecordError
+        from tests.test_controller import _final_review_state
+        state, _ = _final_review_state()
+        for phase in (RunPhase.PRESCRIBE, RunPhase.WRITE, RunPhase.BIND_REVIEW):
+            with self.subTest(phase=phase), self.assertRaises(StateRecordError):
+                replace(state, phase=phase)
+
+    def test_completed_validation_is_not_replayed_after_interrupted_final_review(self):
+        """A fresh session reuses durable final evidence instead of launching checks again."""
+        self._configure()
+        from cwi import finalization
+        original = finalization._review_current_candidate
+
+        def interrupt(preflight, *, state, store, adapter):
+            """Lose the controller before any final Reviewer effect has begun."""
+            raise InjectedCrash("before final reviewer")
+
+        with patch.object(finalization, "_review_current_candidate", interrupt):
+            with self.assertRaises(InjectedCrash):
+                self._start()
+        run_dir = next(self.state_root.joinpath("runs").iterdir())
+        state = StateStore().load_state(run_dir.name)
+        self.assertEqual(state.phase, RunPhase.FINAL_REVIEW)
+        adapter = _RecordingAdapter((_Step(assessment(final=True)),))
+        with patch.object(finalization, "_review_current_candidate", original):
+            state = resume(state.identity.run_id,
+                adapter_factory=lambda state, store: adapter.bind_runtime(state, store))
+        self.assertEqual(state.phase, RunPhase.ACCEPTED_UNMERGED, state.stop_reason)
+        self.assertEqual(self.executions.read_text().splitlines(), ["executed"])
