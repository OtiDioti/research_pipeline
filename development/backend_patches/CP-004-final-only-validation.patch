@@ -0,0 +1,195 @@
+"""Exercise the controller-owned inspection endpoint without running project code."""
+
+from __future__ import annotations
+
+import ast
+import io
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from cwi import source_tools
+
+
+class SourceToolsTests(unittest.TestCase):
+    """Only bounded UTF-8 source inspection is available through this server."""
+
+    def setUp(self) -> None:
+        self.temporary = tempfile.TemporaryDirectory(prefix="cwi-source-tools-")
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        (self.root / "src").mkdir()
+        (self.root / "src" / "hello.py").write_text("# café\nprint('never executed')\nneedle\n", encoding="utf-8")
+        (self.root / ".git").mkdir()
+        (self.root / ".git" / "config").write_text("private marker")
+        (self.root / "workflow_logs").mkdir()
+        (self.root / "workflow_logs" / "private.log").write_text("private marker")
+        self.server = source_tools.SourceTools(self.root)
+        self.addCleanup(self.server.close)
+
+    def call(self, name, arguments):
+        response = self.server.handle_message({"jsonrpc": "2.0", "id": 1, "method": "tools/call",
+                                              "params": {"name": name, "arguments": arguments}})
+        self.assertNotIn("error", response)
+        result = response["result"]
+        self.assertFalse(result.get("isError"), result)
+        return json.loads(result["content"][0]["text"])
+
+    def test_initialize_and_exact_read_only_tool_inventory(self) -> None:
+        initialized = self.server.handle_message({"jsonrpc": "2.0", "id": 2, "method": "initialize",
+            "params": {"protocolVersion": "2025-03-26", "capabilities": {}, "clientInfo": {"name": "test", "version": "1"}}})
+        self.assertEqual(initialized["result"]["protocolVersion"], "2025-03-26")
+        response = self.server.handle_message({"jsonrpc": "2.0", "id": 3, "method": "tools/list"})
+        tools = response["result"]["tools"]
+        self.assertEqual({tool["name"] for tool in tools}, {"list_directory", "read_file", "search_text"})
+        for tool in tools:
+            self.assertFalse(tool["inputSchema"]["additionalProperties"])
+            self.assertTrue(tool["annotations"]["readOnlyHint"])
+
+    def test_useful_utf8_inspection_and_literal_search(self) -> None:
+        listing = self.call("list_directory", {"path": "."})
+        self.assertEqual([entry["name"] for entry in listing["entries"]], ["src"])
+        result = self.call("read_file", {"path": "src/hello.py", "start_line": 2, "max_lines": 1})
+        self.assertEqual(result["text"], "print('never executed')\n")
+        self.assertEqual(result["start_line"], 2)
+        self.assertTrue(result["truncated"])
+        self.assertIn("café", self.call("read_file", {"path": "src/hello.py"})["text"])
+        result = self.call("search_text", {"path": ".", "query": "needle"})
+        self.assertEqual(result["matches"], [{"path": "src/hello.py", "line": 3, "text": "needle"}])
+        self.assertEqual(self.call("search_text", {"query": ".*"})["matches"], [])
+
+    def test_traversal_symlinks_and_reserved_components_are_rejected(self) -> None:
+        outside = self.root.parent / (self.root.name + "-secret")
+        outside.write_text("secret")
+        self.addCleanup(outside.unlink)
+        (self.root / "escape").symlink_to(outside)
+        (self.root / "alias").symlink_to(self.root / "src", target_is_directory=True)
+        for path in ("../" + outside.name, str(outside), ".git/config", "workflow_logs/private.log",
+                     "src/../.git/config", "escape", "alias/hello.py", "src/../../secret", "src\\hello.py"):
+            with self.subTest(path=path):
+                response = self.server.handle_message({"jsonrpc": "2.0", "id": 4, "method": "tools/call",
+                    "params": {"name": "read_file", "arguments": {"path": path}}})
+                self.assertTrue(response["result"]["isError"], response)
+                self.assertNotIn("secret", response["result"]["content"][0]["text"])
+        matches = self.call("search_text", {"query": "private marker"})
+        self.assertEqual(matches["matches"], [])
+        self.assertNotIn("escape", [entry["name"] for entry in self.call("list_directory", {})["entries"]])
+
+    def test_tool_arguments_are_strict_and_bounded(self) -> None:
+        invalid = [
+            ("read_file", {}), ("read_file", {"path": "src/hello.py", "start_line": 0}),
+            ("read_file", {"path": "src/hello.py", "max_lines": True}),
+            ("read_file", {"path": "src/hello.py", "max_lines": 201}),
+            ("read_file", {"path": "x" * 4097}),
+            ("list_directory", {"max_entries": 201}), ("list_directory", {"path": ".", "command": "pytest"}),
+            ("search_text", {"query": ""}), ("search_text", {"query": "a" * 1025}),
+            ("search_text", {"query": "x", "max_results": 101}),
+            ("run_command", {"command": "python -m unittest"}), ("read_file", []),
+        ]
+        for name, arguments in invalid:
+            with self.subTest(name=name, arguments=arguments):
+                response = self.server.handle_message({"jsonrpc": "2.0", "id": 5, "method": "tools/call",
+                    "params": {"name": name, "arguments": arguments}})
+                self.assertTrue(response["result"]["isError"], response)
+
+    def test_directory_pages_reach_entries_beyond_the_first_page(self) -> None:
+        """The replacement inspector can enumerate large source directories completely."""
+        folder = self.root / "many"
+        folder.mkdir()
+        for index in range(405):
+            (folder / f"source-{index:04d}.py").write_text("# source\n")
+        names, offset = [], 0
+        while True:
+            page = self.call("list_directory", {"path": "many", "max_entries": 100, "offset": offset})
+            names.extend(entry["name"] for entry in page["entries"])
+            if page["next_offset"] is None:
+                break
+            self.assertGreater(page["next_offset"], offset)
+            offset = page["next_offset"]
+        self.assertEqual(len(names), 405)
+        self.assertEqual(len(set(names)), 405)
+        self.assertIn("source-0404.py", names)
+
+    def test_bounds_and_invalid_utf8_never_return_unbounded_data(self) -> None:
+        for index in range(5):
+            (self.root / f"item{index}").write_text("needle\n" * 5)
+        self.assertEqual(len(self.call("list_directory", {"max_entries": 2})["entries"]), 2)
+        self.assertTrue(self.call("list_directory", {"max_entries": 2})["truncated"])
+        self.assertEqual(len(self.call("search_text", {"query": "needle", "max_results": 2})["matches"]), 2)
+        self.assertTrue(self.call("search_text", {"query": "needle", "max_results": 2})["truncated"])
+        (self.root / "huge").write_bytes(b"x" * (1024 * 1024 + 1))
+        (self.root / "invalid").write_bytes(b"\xff")
+        for path in ("huge", "invalid"):
+            response = self.server.handle_message({"jsonrpc": "2.0", "id": 6, "method": "tools/call",
+                "params": {"name": "read_file", "arguments": {"path": path}}})
+            self.assertTrue(response["result"]["isError"])
+        (self.root / "longline").write_text("x" * 100000)
+        response = self.server.handle_message({"jsonrpc": "2.0", "id": 7, "method": "tools/call",
+            "params": {"name": "read_file", "arguments": {"path": "longline"}}})
+        self.assertLessEqual(len(json.dumps(response).encode()), 65536)
+
+    def test_stdio_bad_json_invalid_requests_and_notifications(self) -> None:
+        messages = [b"{bad json}\n", b"\xff\n", b"[]\n", b'{"jsonrpc":"2.0","id":1,"method":"execute"}\n',
+                    b'{"jsonrpc":"2.0","id":2,"method":"tools/call","params":[]}\n',
+                    b'{"jsonrpc":"2.0","method":"notifications/initialized"}\n',
+                    b'{"jsonrpc":"2.0","id":3,"method":"ping"}\n']
+        output = io.BytesIO()
+        source_tools.serve(self.server, io.BytesIO(b"".join(messages)), output)
+        responses = [json.loads(line) for line in output.getvalue().splitlines()]
+        self.assertEqual(len(responses), 6)
+        self.assertEqual([r["error"]["code"] for r in responses[:5]], [-32700, -32700, -32600, -32601, -32602])
+        self.assertEqual(responses[-1], {"jsonrpc": "2.0", "id": 3, "result": {}})
+
+    def test_oversized_transport_is_drained_and_next_request_survives(self) -> None:
+        output = io.BytesIO()
+        source_tools.serve(self.server, io.BytesIO(b"x" * 140000 + b'\n{"jsonrpc":"2.0","id":1,"method":"ping"}\n'), output)
+        responses = [json.loads(line) for line in output.getvalue().splitlines()]
+        self.assertEqual(len(responses), 2)
+        self.assertEqual(responses[0]["error"]["code"], -32600)
+        self.assertEqual(responses[1]["result"], {})
+
+    def test_server_has_no_execution_or_project_import_surface(self) -> None:
+        tree = ast.parse(Path(source_tools.__file__).read_text())
+        modules = {node.module.split(".")[0] for node in ast.walk(tree) if isinstance(node, ast.ImportFrom) and node.module}
+        modules.update(alias.name.split(".")[0] for node in ast.walk(tree) if isinstance(node, ast.Import) for alias in node.names)
+        self.assertLessEqual(modules, {"__future__", "argparse", "json", "os", "pathlib", "stat", "sys", "typing"})
+        calls = {node.func.id for node in ast.walk(tree) if isinstance(node, ast.Call) and isinstance(node.func, ast.Name)}
+        self.assertFalse(calls & {"eval", "exec", "compile", "__import__"})
+
+    def test_isolated_stdio_process_ignores_project_python_and_reads_source(self) -> None:
+        """The controller launches its own script, even beside hostile modules."""
+        marker = self.root / "project-code-executed"
+        poison = f"from pathlib import Path\nPath({str(marker)!r}).write_text('executed')\nraise RuntimeError('project import')\n"
+        for name in ("json.py", "sitecustomize.py", "os.py"):
+            (self.root / name).write_text(poison)
+        requests = [
+            {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {
+                "protocolVersion": "2025-03-26", "capabilities": {}, "clientInfo": {"name": "test", "version": "1"}}},
+            {"jsonrpc": "2.0", "method": "notifications/initialized"},
+            {"jsonrpc": "2.0", "id": 2, "method": "tools/list"},
+            {"jsonrpc": "2.0", "id": 3, "method": "tools/call", "params": {
+                "name": "read_file", "arguments": {"path": "src/hello.py"}}},
+            {"jsonrpc": "2.0", "id": 4, "method": "tools/call", "params": {
+                "name": "run_command", "arguments": {"command": "python -m unittest"}}},
+        ]
+        completed = subprocess.run([sys.executable, "-I", "-B", str(Path(source_tools.__file__).resolve()),
+                                    "--root", str(self.root)],
+            cwd=self.root, env={**os.environ, "PYTHONPATH": str(self.root)},
+            input="".join(json.dumps(request) + "\n" for request in requests),
+            capture_output=True, text=True, timeout=10, check=False)
+        self.assertEqual(completed.returncode, 0, completed.stderr)
+        self.assertEqual(completed.stderr, "")
+        responses = [json.loads(line) for line in completed.stdout.splitlines()]
+        self.assertEqual([response["id"] for response in responses], [1, 2, 3, 4])
+        self.assertIn("café", json.loads(responses[2]["result"]["content"][0]["text"])["text"])
+        self.assertTrue(responses[3]["result"]["isError"])
+        self.assertFalse(marker.exists())
+        self.assertFalse((self.root / "__pycache__").exists())
+
+
+if __name__ == "__main__":
+    unittest.main()
