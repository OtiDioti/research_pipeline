@@ -0,0 +1,373 @@
+"""Dependency-free, bounded read-only source inspection over MCP JSON-RPC stdio.
+
+Launched by absolute script path with isolated Python; never import the inspected
+project. Descriptor-relative opens reject symlinks even during concurrent edits.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path
+import stat
+import sys
+from typing import Any, BinaryIO
+
+
+MAX_REQUEST_BYTES = 128 * 1024
+MAX_RESPONSE_BYTES = 64 * 1024
+MAX_FILE_BYTES = 1024 * 1024
+MAX_TEXT_BYTES = 8192
+MAX_DATA_BYTES = 24 * 1024
+MAX_DIRECTORY_ENTRIES = 2000
+MAX_SEARCH_ENTRIES = 10000
+MAX_SEARCH_FILES = 1000
+MAX_SEARCH_BYTES = 8 * 1024 * 1024
+MAX_DEPTH = 32
+RESERVED = frozenset({".git", "workflow_logs"})
+_OPEN_FLAGS = os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK
+
+
+def _schema(properties: dict[str, Any], required: list[str]) -> dict[str, Any]:
+    """Describe a closed MCP argument object without execution-capable fields."""
+    return {"type": "object", "properties": properties, "required": required, "additionalProperties": False}
+
+
+_PATH = {"type": "string", "maxLength": 4096, "description": "Relative worktree path; no symlinks, parent traversal or reserved directories."}
+TOOLS = [
+    {"name": "list_directory", "description": "List bounded immediate source entries; .git, workflow_logs and symlinks are excluded.",
+     "inputSchema": _schema({"path": _PATH, "max_entries": {"type": "integer", "minimum": 1, "maximum": 200},
+                              "offset": {"type": "integer", "minimum": 0, "maximum": 1000000}}, []),
+     "annotations": {"readOnlyHint": True, "destructiveHint": False, "openWorldHint": False}},
+    {"name": "read_file", "description": "Read bounded UTF-8 source lines (regular files up to 1 MiB; output may truncate).",
+     "inputSchema": _schema({"path": _PATH, "start_line": {"type": "integer", "minimum": 1, "maximum": 1000000},
+                              "max_lines": {"type": "integer", "minimum": 1, "maximum": 200}}, ["path"]),
+     "annotations": {"readOnlyHint": True, "destructiveHint": False, "openWorldHint": False}},
+    {"name": "search_text", "description": "Search literal text in UTF-8 source, bounded by files, bytes, depth and match count. No regular expressions or execution.",
+     "inputSchema": _schema({"path": _PATH, "query": {"type": "string", "minLength": 1, "maxLength": 1024},
+                              "max_results": {"type": "integer", "minimum": 1, "maximum": 100}}, ["query"]),
+     "annotations": {"readOnlyHint": True, "destructiveHint": False, "openWorldHint": False}},
+]
+
+
+class SourceError(ValueError):
+    """Safe diagnostics never include caller paths or source data."""
+
+
+def _encoded_size(value: Any) -> int:
+    # The ASCII encoding also bounds clients which escape non-ASCII characters.
+    """Bound JSON payload size even for clients which escape non-ASCII text."""
+    return len(json.dumps(value, ensure_ascii=True).encode("ascii"))
+
+
+def _prefix(text: str, limit: int) -> str:
+    """Return a valid UTF-8 prefix within the requested byte budget."""
+    return text.encode("utf-8")[:limit].decode("utf-8", errors="ignore")
+
+
+class SourceTools:
+    """Expose only three operations below one controller-selected directory."""
+
+    def __init__(self, root: Path) -> None:
+        """Open the absolute source root as a pinned no-follow directory descriptor."""
+        if not root.is_absolute():
+            raise SourceError("source root must be absolute")
+        self._root_fd = os.open(root, _OPEN_FLAGS | os.O_DIRECTORY)
+
+    def close(self) -> None:
+        """Release the pinned root descriptor; repeated cleanup is harmless."""
+        if self._root_fd >= 0:
+            os.close(self._root_fd)
+            self._root_fd = -1
+
+    @staticmethod
+    def _parts(path: Any) -> tuple[str, ...]:
+        """Validate a relative source path and reject reserved or escaping components."""
+        if not isinstance(path, str) or not path or len(path) > 4096 or "\x00" in path or "\\" in path:
+            raise SourceError("invalid source path")
+        if path.startswith("/"):
+            raise SourceError("source path must be relative")
+        parts = tuple(part for part in path.split("/") if part not in ("", "."))
+        if len(parts) > MAX_DEPTH or any(part == ".." or part in RESERVED for part in parts):
+            raise SourceError("source path is outside the permitted surface")
+        try:
+            path.encode("utf-8")
+        except UnicodeError:
+            raise SourceError("invalid source path encoding") from None
+        return parts
+
+    def _open(self, path: str) -> int:
+        """Open each component beneath the pinned root without following symlinks."""
+        parts = self._parts(path)
+        fd = os.dup(self._root_fd)
+        try:
+            for index, part in enumerate(parts):
+                flags = _OPEN_FLAGS | (os.O_DIRECTORY if index < len(parts) - 1 else 0)
+                child = os.open(part, flags, dir_fd=fd)
+                os.close(fd)
+                fd = child
+            return fd
+        except BaseException:
+            os.close(fd)
+            raise
+
+    @staticmethod
+    def _integer(arguments: dict[str, Any], name: str, default: int, maximum: int) -> int:
+        """Require a bounded integer while rejecting booleans and coercion."""
+        value = arguments.get(name, default)
+        if type(value) is not int or not 1 <= value <= maximum:
+            raise SourceError("integer argument outside permitted bounds")
+        return value
+
+    @staticmethod
+    def _entries(fd: int, maximum: int) -> tuple[list[dict[str, str]], bool, int]:
+        """Collect bounded immediate metadata without following symlinks or reading code."""
+        entries = []
+        count = 0
+        truncated = False
+        with os.scandir(fd) as iterator:
+            for entry in iterator:
+                count += 1
+                if count > maximum:
+                    truncated = True
+                    break
+                if entry.name in RESERVED:
+                    continue
+                try:
+                    entry.name.encode("utf-8")
+                    mode = entry.stat(follow_symlinks=False).st_mode
+                except (OSError, UnicodeError):
+                    truncated = True
+                    continue
+                if stat.S_ISDIR(mode):
+                    kind = "directory"
+                elif stat.S_ISREG(mode):
+                    kind = "file"
+                else:
+                    continue
+                entries.append({"name": entry.name, "type": kind})
+        return sorted(entries, key=lambda item: item["name"]), truncated, min(count, maximum)
+
+    def _read_bytes(self, path: str, maximum: int = MAX_FILE_BYTES) -> bytes:
+        """Read one bounded regular file through the confined descriptor chain."""
+        fd = self._open(path)
+        try:
+            info = os.fstat(fd)
+            if not stat.S_ISREG(info.st_mode) or info.st_size > maximum:
+                raise SourceError("source must be a regular file no larger than 1 MiB")
+            with os.fdopen(fd, "rb", closefd=False) as stream:
+                data = stream.read(maximum + 1)
+            if len(data) > maximum:
+                raise SourceError("source exceeds file limit")
+            return data
+        finally:
+            os.close(fd)
+
+    def _list(self, arguments: dict[str, Any]) -> dict[str, Any]:
+        """Return a bounded directory page and its raw-entry continuation offset.
+
+        Offsets count filesystem entries, including hidden reserved/symlink entries,
+        so filtering never prevents forward progress. Pages are stable while the
+        inspected directory is unchanged, as required for bound review source.
+        """
+        path = arguments.get("path", ".")
+        limit = self._integer(arguments, "max_entries", 200, 200)
+        offset = arguments.get("offset", 0)
+        if type(offset) is not int or not 0 <= offset <= 1000000:
+            raise SourceError("directory offset outside permitted bounds")
+        selected, scanned, next_offset = [], 0, None
+        fd = self._open(path)
+        try:
+            if not stat.S_ISDIR(os.fstat(fd).st_mode):
+                raise SourceError("source must be a directory")
+            with os.scandir(fd) as iterator:
+                for index, entry in enumerate(iterator):
+                    if index < offset:
+                        continue
+                    if scanned >= MAX_DIRECTORY_ENTRIES or len(selected) >= limit:
+                        next_offset = index
+                        break
+                    scanned += 1
+                    if entry.name in RESERVED:
+                        continue
+                    try:
+                        entry.name.encode("utf-8")
+                        mode = entry.stat(follow_symlinks=False).st_mode
+                    except (OSError, UnicodeError):
+                        continue
+                    if not (stat.S_ISDIR(mode) or stat.S_ISREG(mode)):
+                        continue
+                    item = {"name": entry.name, "type": "directory" if stat.S_ISDIR(mode) else "file"}
+                    if _encoded_size(selected + [item]) > MAX_DATA_BYTES:
+                        next_offset = index
+                        break
+                    selected.append(item)
+        finally:
+            os.close(fd)
+        return {"entries": sorted(selected, key=lambda item: item["name"]),
+                "truncated": next_offset is not None, "next_offset": next_offset}
+
+    def _read_lines(self, arguments: dict[str, Any]) -> dict[str, Any]:
+        """Return a bounded UTF-8 line page without interpreting source content."""
+        start = self._integer(arguments, "start_line", 1, 1000000)
+        limit = self._integer(arguments, "max_lines", 200, 200)
+        lines = self._read_bytes(arguments["path"]).decode("utf-8").splitlines(keepends=True)
+        selected = "".join(lines[start - 1:start - 1 + limit])
+        bounded = _prefix(selected, MAX_TEXT_BYTES)
+        return {"start_line": start, "text": bounded,
+                "truncated": len(lines) > start - 1 + limit or len(bounded) < len(selected)}
+
+    def _search(self, arguments: dict[str, Any]) -> dict[str, Any]:
+        """Search literal text with bounded file, byte, traversal and result budgets."""
+        query = arguments["query"]
+        if not isinstance(query, str) or not 1 <= len(query) <= 1024:
+            raise SourceError("literal query must contain 1 to 1024 characters")
+        query.encode("utf-8")
+        limit = self._integer(arguments, "max_results", 100, 100)
+        path = arguments.get("path", ".")
+        self._parts(path)
+        pending = [(path, 0)]
+        matches: list[dict[str, Any]] = []
+        total_bytes = 0
+        files = 0
+        entries_seen = 0
+        truncated = False
+        while pending:
+            current, depth = pending.pop()
+            try:
+                fd = self._open(current)
+                try:
+                    mode = os.fstat(fd).st_mode
+                    if stat.S_ISDIR(mode):
+                        remaining = MAX_SEARCH_ENTRIES - entries_seen
+                        if depth >= MAX_DEPTH or remaining <= 0:
+                            truncated = True
+                            continue
+                        entries, cut, scanned = self._entries(fd, min(remaining, MAX_DIRECTORY_ENTRIES))
+                        entries_seen += scanned
+                        truncated |= cut
+                        # Bound the queue as well as the number of scanned entries.
+                        pending.extend(((current.rstrip("/") + "/" + entry["name"], depth + 1)
+                                        for entry in reversed(entries)))
+                        continue
+                    if not stat.S_ISREG(mode):
+                        truncated = True
+                        continue
+                finally:
+                    os.close(fd)
+                if files >= MAX_SEARCH_FILES or total_bytes >= MAX_SEARCH_BYTES:
+                    truncated = True
+                    break
+                files += 1
+                data = self._read_bytes(current, min(MAX_FILE_BYTES, MAX_SEARCH_BYTES - total_bytes))
+                total_bytes += len(data)
+                text = data.decode("utf-8")
+                for number, line in enumerate(text.splitlines(), 1):
+                    if query not in line:
+                        continue
+                    match = {"path": "/".join(self._parts(current)), "line": number, "text": _prefix(line, 512)}
+                    if len(matches) >= limit or _encoded_size(matches + [match]) > MAX_DATA_BYTES:
+                        return {"matches": matches, "truncated": True}
+                    matches.append(match)
+            except (OSError, SourceError, UnicodeError):
+                # Binary, unavailable and changing files are omitted, never executed.
+                truncated = True
+        return {"matches": matches, "truncated": truncated}
+
+    def _call(self, name: Any, arguments: Any) -> dict[str, Any]:
+        """Dispatch only the closed inspection inventory and sanitize refused requests."""
+        try:
+            tool = next((tool for tool in TOOLS if tool["name"] == name), None)
+            if tool is None or not isinstance(arguments, dict):
+                raise SourceError("unknown tool or invalid arguments")
+            schema = tool["inputSchema"]
+            if set(arguments) - set(schema["properties"]) or set(schema["required"]) - set(arguments):
+                raise SourceError("unknown or missing tool arguments")
+            operation = {"list_directory": self._list, "read_file": self._read_lines, "search_text": self._search}[name]
+            result = {"content": [{"type": "text", "text": json.dumps(operation(arguments), ensure_ascii=True)}], "isError": False}
+            if _encoded_size(result) > MAX_RESPONSE_BYTES - 1024:
+                raise SourceError("inspection output exceeds response limit")
+            return result
+        except (OSError, SourceError, UnicodeError, TypeError):
+            return {"content": [{"type": "text", "text": "Inspection refused: invalid, unavailable or out-of-bounds source request."}], "isError": True}
+
+    def handle_message(self, message: Any) -> dict[str, Any] | None:
+        """Handle MCP initialization, inspection and notifications without side effects."""
+        if not isinstance(message, dict) or message.get("jsonrpc") != "2.0" or not isinstance(message.get("method"), str):
+            return _error(None, -32600, "Invalid Request")
+        identity = message.get("id")
+        if "id" in message and (type(identity) not in (str, int) or isinstance(identity, str) and len(identity) > 256):
+            return _error(None, -32600, "Invalid Request")
+        if "id" not in message:
+            return None
+        params = message.get("params", {})
+        if not isinstance(params, dict):
+            return _error(identity, -32602, "Invalid params")
+        method = message["method"]
+        if method == "initialize":
+            version = params.get("protocolVersion")
+            if not isinstance(version, str):
+                return _error(identity, -32602, "Invalid params")
+            result = {"protocolVersion": version if version in {"2024-11-05", "2025-03-26", "2025-06-18", "2025-11-25"} else "2025-06-18",
+                      "capabilities": {"tools": {}}, "serverInfo": {"name": "cwi-source", "version": "1"}}
+        elif method == "ping":
+            result = {}
+        elif method == "tools/list":
+            result = {"tools": TOOLS}
+        elif method == "tools/call":
+            if set(params) - {"name", "arguments", "_meta"} or "name" not in params:
+                return _error(identity, -32602, "Invalid params")
+            result = self._call(params["name"], params.get("arguments", {}))
+        else:
+            return _error(identity, -32601, "Method not found")
+        return {"jsonrpc": "2.0", "id": identity, "result": result}
+
+
+def _error(identity: Any, code: int, message: str) -> dict[str, Any]:
+    """Construct a JSON-RPC error without exposing inspected source data."""
+    return {"jsonrpc": "2.0", "id": identity, "error": {"code": code, "message": message}}
+
+
+def serve(server: SourceTools, incoming: BinaryIO, outgoing: BinaryIO) -> None:
+    """Process newline-delimited MCP messages with bounded reads and responses."""
+    while True:
+        line = incoming.readline(MAX_REQUEST_BYTES + 1)
+        if not line:
+            return
+        if len(line) > MAX_REQUEST_BYTES:
+            while line and not line.endswith(b"\n"):
+                line = incoming.readline(MAX_REQUEST_BYTES + 1)
+            response = _error(None, -32600, "Request exceeds transport limit")
+        else:
+            try:
+                response = server.handle_message(json.loads(line.decode("utf-8")))
+            except (UnicodeError, ValueError, RecursionError):
+                response = _error(None, -32700, "Parse error")
+        if response is not None:
+            data = json.dumps(response, ensure_ascii=True).encode("ascii")
+            if len(data) > MAX_RESPONSE_BYTES:
+                data = json.dumps(_error(None, -32603, "Response exceeds transport limit")).encode("ascii")
+            outgoing.write(data + b"\n")
+            outgoing.flush()
+
+
+def main() -> int:
+    """Start the isolated read-only endpoint for one controller-selected root."""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--root", type=Path, required=True)
+    arguments = parser.parse_args()
+    try:
+        server = SourceTools(arguments.root)
+    except (OSError, SourceError):
+        print("Source inspection root unavailable", file=sys.stderr)
+        return 2
+    try:
+        serve(server, sys.stdin.buffer, sys.stdout.buffer)
+    finally:
+        server.close()
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
