diff --git a/tests/test_native_tools.py b/tests/test_native_tools.py
new file mode 100644
index 0000000..ebbe2a3
--- /dev/null
+++ b/tests/test_native_tools.py
@@ -0,0 +1,133 @@
+"""Prove actual CLI tool restrictions with a localhost-only, credential-free stub."""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+import subprocess
+import threading
+import tempfile
+import unittest
+from http.server import BaseHTTPRequestHandler, HTTPServer
+from unittest.mock import patch
+
+from cwi.codex_cli import CodexCliAdapter, InvocationStatus, SandboxRole
+from cwi.codex_runtime import _candidate_paths, discover_codex
+from cwi.response_schemas import AgentRole
+
+
+class NativeToolsTests(unittest.TestCase):
+    """Exercise registered handlers, rather than inferring permission from flags."""
+
+    def test_direct_inspection_and_patch_work_while_commands_and_dispatcher_are_refused(self):
+        """No real model is called: the local stub scripts permitted and forbidden calls."""
+        if not any(path.exists() for path in _candidate_paths(os.environ)):
+            self.skipTest("installed Codex CLI unavailable")
+        identity = discover_codex(os.environ)
+        with tempfile.TemporaryDirectory(prefix="cwi-native-tools-") as temporary:
+            root = Path(temporary)
+            repository = root / "repository"
+            repository.mkdir()
+            (repository / "source.txt").write_text("source inspection canary\n")
+            subprocess.run(["git", "init", "-q", str(repository)], check=True)
+            runtime, account, codex_home = (root / name for name in ("runtime", "account", "codex-home"))
+            for folder in (runtime, account, codex_home):
+                folder.mkdir(mode=0o700)
+            requests = []
+            calls = [
+                {"type": "function_call", "name": "read_file", "namespace": "mcp__cwi_source",
+                 "arguments": json.dumps({"path": "source.txt"})},
+                {"type": "function_call", "name": "exec_command", "namespace": "functions",
+                 "arguments": json.dumps({"cmd": "printf forbidden", "max_output_tokens": 100})},
+                {"type": "custom_tool_call", "name": "exec", "namespace": "functions",
+                 "input": "text('DISPATCHER_MUST_NOT_EXECUTE')"},
+                {"type": "custom_tool_call", "name": "apply_patch", "namespace": "functions",
+                 "input": "*** Begin Patch\n*** Add File: changed.txt\n+native patch works\n*** End Patch"},
+            ]
+
+            class Stub(BaseHTTPRequestHandler):
+                """Serve deterministic Responses SSE without storing headers or credentials."""
+
+                def log_message(self, *args):
+                    """Keep routine local HTTP logs out of the test output."""
+
+                def do_POST(self):
+                    """Script one tool call or the final schema response, with a hard call bound."""
+                    request = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
+                    requests.append(request)
+                    index = len(requests) - 1
+                    if index < len(calls):
+                        item = calls[index] | {"id": f"item_{index}", "call_id": f"call_{index}", "status": "completed"}
+                    else:
+                        item = {"type": "message", "role": "assistant", "id": "msg_done", "status": "completed",
+                                "content": [{"type": "output_text", "annotations": [], "text": json.dumps(dict(
+                                    status="completed", summary="Inspected source and applied a native patch.", reason=""))}]}
+                    response = {"id": f"resp_{index}", "object": "response", "status": "completed", "output": [item],
+                                "usage": {"input_tokens": 0, "output_tokens": 0, "total_tokens": 0}}
+                    self.send_response(200)
+                    self.send_header("Content-Type", "text/event-stream")
+                    self.end_headers()
+                    events = [("response.created", {"response": response | {"status": "in_progress", "output": []}}),
+                              ("response.output_item.added", {"output_index": 0, "item": item}),
+                              ("response.output_item.done", {"output_index": 0, "item": item}),
+                              ("response.completed", {"response": response})]
+                    for name, data in events:
+                        self.wfile.write((f"event: {name}\ndata: {json.dumps(data | {'type': name})}\n\n").encode())
+                    self.wfile.flush()
+
+            try:
+                server = HTTPServer(("127.0.0.1", 0), Stub)
+            except PermissionError:
+                self.skipTest("sandbox forbids the localhost-only offline transport probe")
+            worker = threading.Thread(target=server.serve_forever, daemon=True)
+            worker.start()
+            self.addCleanup(server.server_close)
+            adapter = CodexCliAdapter(executable=Path(identity.path), runtime_home=runtime, account_home=account,
+                source_environment={"PATH": os.environ["PATH"], "CODEX_HOME": str(codex_home)})
+            original_command = adapter._command
+
+            def local_command(**arguments):
+                """Redirect only this test's model transport to the local stub, without authentication."""
+                command = original_command(**arguments)
+                provider = ("model_providers.cwi_probe={name=\"CWI offline probe\",wire_api=\"responses\","
+                            f"base_url=\"http://127.0.0.1:{server.server_port}/v1\",requires_openai_auth=false}}")
+                command[1:1] = ["--no-daemon", "-c", 'model_provider="cwi_probe"', "-c", provider]
+                return command
+
+            try:
+                with patch.object(adapter, "_command", side_effect=local_command):
+                    result = adapter.invoke(role=AgentRole.WRITER, prompt="Use direct source inspection and native patch editing only. Never execute tests or commands.",
+                        cwd=repository, sandbox=SandboxRole.WORKSPACE_WRITE, timeout_seconds=30,
+                        artifact_dir=root / "artifacts", model="gpt-6.1-sol", reasoning_effort="high")
+            finally:
+                server.shutdown()
+                worker.join(timeout=5)
+            self.assertEqual(result.status, InvocationStatus.SUCCEEDED)
+            self.assertEqual(len(requests), 5)
+            definitions = list(requests[0].get("tools", []))
+            for message in requests[0].get("input", []):
+                if message.get("type") == "additional_tools":
+                    definitions.extend(message.get("tools", []))
+            namespaces = {tool["name"]: {entry["name"] for entry in tool.get("tools", [])}
+                          for tool in definitions if tool.get("type") == "namespace"}
+            self.assertTrue({"list_directory", "read_file", "search_text"} <= namespaces.get("mcp__cwi_source", set()),
+                            "the model must see the source tools, not just hidden callable handlers")
+            self.assertIn("apply_patch", namespaces.get("functions", set()))
+            self.assertFalse({"exec_command", "write_stdin", "python", "js_repl"} & namespaces.get("functions", set()))
+
+            outputs = {}
+            for request in requests:
+                for item in request.get("input", []):
+                    if item.get("type") in ("function_call_output", "custom_tool_call_output"):
+                        outputs[item["call_id"]] = json.dumps(item["output"])
+            self.assertIn("source inspection canary", outputs["call_0"])
+            self.assertIn("unsupported", outputs["call_1"].lower())
+            self.assertIn("code-mode host is disabled", outputs["call_2"])
+            self.assertNotIn("DISPATCHER_MUST_NOT_EXECUTE", outputs["call_2"])
+            self.assertEqual((repository / "changed.txt").read_text(), "native patch works\n")
+            self.assertEqual((repository / "source.txt").read_text(), "source inspection canary\n")
+            items = [event.get("item", {}) for event in result.events]
+            self.assertFalse(any(item.get("type") == "command_execution" for item in items))
+            self.assertTrue(any(item.get("type") == "file_change" and item.get("status") == "completed" for item in items))
+            self.assertFalse((codex_home / "auth.json").exists())
