+        "mcp_servers={cwi_source={command=" + json.dumps(str(Path(sys.executable).resolve()))
+        + ",args=" + json.dumps(args) + ",required=true,"
+        'enabled_tools=["list_directory","read_file","search_text"]}}'
+    )
